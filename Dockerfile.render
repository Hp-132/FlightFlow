# Single-container hosted demo (e.g. Render free tier): the API also serves
# the built dashboard and runs relay + planner + worker + mock partners
# in-process (ALL_IN_ONE). The multi-service Dockerfile + Compose setup is
# unchanged; this file is only for one-instance hosting.

# ---- dashboard build ------------------------------------------------------
FROM node:22-alpine AS dashboard
WORKDIR /dashboard
COPY dashboard/package*.json ./
RUN npm ci
COPY dashboard/ ./
# Same-origin API: the browser calls relative paths on this very host.
# The key is baked into the bundle at build time (it is visible to anyone
# who opens the site, so treat it as a demo key, not a secret).
ARG VITE_API_KEY
ENV VITE_API_URL=/ \
    VITE_API_KEY=${VITE_API_KEY}
RUN npm run build

# ---- python app -----------------------------------------------------------
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src ./src
COPY migrations ./migrations
COPY finops ./finops
COPY alembic.ini ./

RUN pip install --no-cache-dir -e .

COPY --from=dashboard /dashboard/dist /app/dashboard-dist

ENV PYTHONPATH=/app/src \
    ALL_IN_ONE=true \
    DASHBOARD_DIST=/app/dashboard-dist \
    STORAGE_DIR=/app/data

ENTRYPOINT ["python", "-m", "reflight.cli"]
CMD ["api"]
