
POSTGRES_USER=reflight
POSTGRES_PASSWORD=changeme
POSTGRES_DB=reflight
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# ---- RabbitMQ ----
RABBITMQ_DEFAULT_USER=reflight
RABBITMQ_DEFAULT_PASS=changeme
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_PROMETHEUS_PORT=15692

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- MinIO ----
MINIO_ROOT_USER=reflight
MINIO_ROOT_PASSWORD=changeme123
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=reflight

# ---- Grafana (wired up in Phase 6) ----
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme
GRAFANA_PORT=3000

# ---- Prometheus (wired up in Phase 6) ----
PROMETHEUS_PORT=9090

# ---- API ----
API_PORT=8000
API_STATIC_KEY=dev-local-key-change-me

# ---- Dashboard ----
DASHBOARD_PORT=5173

# ---- Hosted deployment (leave unset for local Docker Compose) ----
# Managed providers give you one connection string instead of parts. When
# any of these is set it overrides the host/port/user/password above.
#   DATABASE_URL=postgresql://user:pass@host/dbname      (Render, Neon, Supabase)
#   RABBITMQ_URL=amqps://user:pass@host/vhost            (CloudAMQP)
#   REDIS_URL=rediss://default:pass@host:6379            (Render Key Value, Upstash)
#   S3_ENDPOINT_URL=                                     (empty = real AWS S3)
# postgres:// is normalised to the psycopg driver automatically.
